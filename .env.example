# Environment Configuration for SecureX Fraud Engine
# Copy to .env and fill in real values. NEVER commit .env.

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
DEBUG=false

# Security / Encryption
SECRET_KEY=change-me-to-a-random-string
API_KEY_HEADER=X-API-Key

# V2 Authentication (service-to-service boundary with securex-platform)
# Set ENABLE_AUTH=false ONLY for local development without authentication.
# API_KEYS is a comma-separated list of accepted keys. Never leave empty
# while ENABLE_AUTH=true.
ENABLE_AUTH=true
API_KEYS=change-me-to-a-secure-platform-key

# Database (PostgreSQL is PLANNED; currently uses in-memory dev repositories)
DATABASE_URL=postgresql://user:password@host:5432/securex_fraud

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# SecureX Integration
SECUREX_PLATFORM_URL=http://localhost:3000
SECUREX_BLOCKCHAIN_URL=http://localhost:8545
# Blockchain verification mode: mock (tests/dev) | live (real endpoint) | unavailable (default/unconfigured)
# Mock is for tests ONLY and is never used to fake production verification.
BLOCKCHAIN_VERIFY_MODE=unavailable
BLOCKCHAIN_TIMEOUT_SECONDS=5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload (secure document pipeline)
MAX_UPLOAD_SIZE_MB=10
# ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# Analysis Thresholds
FRAUD_SCORE_THRESHOLD=0.7
RISK_HIGH_THRESHOLD=0.8
RISK_MEDIUM_THRESHOLD=0.5

# Credential consistency - fields required before comparison
REQUIRED_CREDENTIAL_FIELDS=credential_id,issuer_id,credential_type
