# Environment Configuration for SecureX Fraud Engine
# Copy to .env and fill in real values. NEVER commit .env.

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
DEBUG=false

# Security
SECRET_KEY=change-me-to-a-random-string
API_KEY_HEADER=X-API-Key

# Database (optional - only if persistence needed)
DATABASE_URL=postgresql://user:password@host:5432/securex_fraud

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# SecureX Integration
SECUREX_PLATFORM_URL=http://localhost:3000
SECUREX_BLOCKCHAIN_URL=http://localhost:8545

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_UPLOAD_SIZE_MB=10
# ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# Analysis Thresholds
FRAUD_SCORE_THRESHOLD=0.7
RISK_HIGH_THRESHOLD=0.8
RISK_MEDIUM_THRESHOLD=0.5
